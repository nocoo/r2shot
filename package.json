{
  "name": "r2shot",
  "version": "1.3.1",
  "private": true,
  "description": "Chrome extension to capture screenshots and upload to Cloudflare R2",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write --error-on-warnings",
    "build:zip": "bash scripts/build.sh",
    "prepare": "git config core.hookspath .husky",
    "release": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "0.2.5",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1104.0",
    "brace-expansion": "5.0.9",
    "clsx": "^2.1.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "8.21.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "overrides": {
    "ws": "^8.21.2",
    "esbuild": "^0.28.1",
    "vite": "^8.2.0",
    "brace-expansion": "^5.0.9"
  }
}
