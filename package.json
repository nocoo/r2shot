{
  "name": "r2shot",
  "version": "2.0.0",
  "private": true,
  "description": "Chrome extension to capture screenshots and upload to Cloudflare R2",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write --error-on-warnings",
    "build:zip": "bash scripts/build.sh",
    "prepare": "git config core.hookspath .husky",
    "release": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun install --frozen-lockfile && bun run lint && bun run build && bun run test:coverage && bun run test:e2e",
    "materials": "python3 scripts/materials/build.py",
    "materials:check": "node scripts/materials/check.cjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1134.0",
    "@biomejs/biome": "2.5.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/chrome": "0.3.0",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "puppeteer": "25.11.0",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {},
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "overrides": {
    "nanoid": "3.3.18",
    "ws": "^8.21.3",
    "esbuild": "^0.28.1",
    "vite": "^8.3.0",
    "brace-expansion": "^5.0.9"
  }
}
