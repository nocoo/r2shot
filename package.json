{
  "name": "r2shot",
  "version": "2.0.3",
  "private": true,
  "description": "Chrome extension to capture screenshots and upload to Cloudflare R2",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node tests/e2e/extension.e2e.cjs",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write --error-on-warnings",
    "build:zip": "bash scripts/build.sh",
    "prepare": "husky",
    "release": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun install --frozen-lockfile && bun run lint && bun run build && bun run test:coverage && bun run test:integration && bun run test:e2e",
    "materials": "python3 scripts/materials/build.py",
    "materials:check": "node scripts/materials/check.cjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@biomejs/biome": "2.5.14",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "puppeteer": "25.11.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {},
  "overrides": {
    "nanoid": "3.3.19",
    "ws": "^8.21.3",
    "vite": "^8.3.0"
  }
}
